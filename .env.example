# DeepSeek provider configuration. Keep the real key only in the untracked local .env file.
DEEPSEEK_API_KEY=replace-with-your-authorized-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=replace-with-a-verified-model-name

# Local browser/API configuration
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# Backend data paths. These are interpreted inside the backend container or working directory.
POLICY_FILE_PATH=../data/sample_policy.md
CLAIMS_FILE_PATH=../data/mock_claims.json

# Service ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
