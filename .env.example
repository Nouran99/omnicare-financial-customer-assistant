# DeepSeek provider configuration. Keep the real key only in the untracked local .env file.
DEEPSEEK_API_KEY=replace-with-your-authorized-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=replace-with-a-verified-model-name
DEEPSEEK_TIMEOUT_SECONDS=30

# Application and local browser/API configuration
APP_NAME=OmniCare Financial Customer Assistant
APP_VERSION=0.1.0
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# Local data paths. These are interpreted inside the backend container or working directory.
POLICY_FILE_PATH=../data/sample_policy.md
CLAIMS_FILE_PATH=../data/mock_claims.json
POLICY_INDEX_PATH=../runtime/chroma
POLICY_COLLECTION_NAME=omnicare_policy
POLICY_EMBEDDING_DIMENSION=384
POLICY_RETRIEVAL_TOP_K=2
POLICY_RETRIEVAL_MIN_RELEVANCE=0.15
POLICY_QUERY_MAX_LENGTH=512
POLICY_EMBEDDING_STOPWORDS=a,an,and,are,as,at,be,by,can,does,for,from,how,in,is,it,much,of,on,or,policy,the,to,what,when,where,with,available,cover,covered,coverage,damage

# Public API limits
USER_ID_MAX_LENGTH=128
MESSAGE_MAX_LENGTH=8000
SOURCE_MAX_LENGTH=512
MAX_SOURCES=20
TOOL_NAME_MAX_LENGTH=64
TOOL_STATUS_MAX_LENGTH=32
TOOL_ARGUMENTS_MAX_LENGTH=1000
TOOL_RESULT_MAX_LENGTH=2000
MAX_TOOL_CALLS=20
REQUEST_ID_MAX_LENGTH=64
POLICY_SECTION_ID_MAX_LENGTH=64
POLICY_SECTION_TITLE_MAX_LENGTH=256
POLICY_CHUNK_TEXT_MAX_LENGTH=12000
POLICY_SOURCE_FILE_MAX_LENGTH=256
POLICY_CITATION_MAX_LENGTH=512

# Claims domain behavior
CLAIM_ID_MAX_LENGTH=64
POLICY_NUMBER_MAX_LENGTH=128
CLAIM_TYPE_MAX_LENGTH=128
CLAIM_STATUS_MAX_LENGTH=64
CLAIM_DESCRIPTION_MAX_LENGTH=4000
CLAIM_AMOUNT_MIN=0
CLAIM_AMOUNT_DECIMAL_PLACES=2
INITIAL_CLAIM_STATUS=Submitted

# Service ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
